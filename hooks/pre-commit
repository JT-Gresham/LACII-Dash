#!/bin/sh
# pre-commit: refuse to COMMIT a secret, on any remote, at all.
#
# Why this exists alongside pre-push: pre-push is too late. By the time it fires the secret is
# already in a local commit, and removing it means an interactive rebase or a reset — on a branch
# that may already have work stacked on top. Blocking at commit keeps the working tree the only
# place it ever existed, so the fix is `git restore --staged` and an edit.
#
# It is also stricter than pre-push on purpose: pre-push exempts LAN remotes (LAN-scoped secrets
# are policy-allowed there), but a commit has no remote yet — the same commit can later be pushed
# anywhere, so "which remote" is not yet knowable and must not be assumed benign.
#
# Enable (once per clone; core.hooksPath is local config, not tracked):
#     git config core.hooksPath hooks
# Bypass, only when certain a match is a false positive:  git commit --no-verify

. "$(dirname "$0")/_secret-patterns.sh"

# ---------------------------------------------------------------- truncation tripwire ----------
# This repo lives inside a Nextcloud-synced directory. The sync client can write a PARTIAL file,
# leaving a source file cut mid-line at a fraction of its length. It has happened twice:
# dashboard_html.py (2249 -> 114 lines) and then five files at once — engine_gen.py 1891 -> 151,
# multimodal.py 1285 -> 147, routes_lifecycle.py 842 -> 132, worker_net.py 505 -> 125.
# Excluding .git from the sync (already done) protects the REPO but not the working files.
#
# Committing one is the disaster case, not merely untidy: most of these are in server.py's
# EXTRA_UPDATE_FILES, so a truncated commit self-updates to every controller and worker in the
# fleet. multimodal.py in that state does not even import — the controller would fail to start.
#
# Signature is unmistakable and cheap to test: the file shrank a lot AND the diff adds nothing.
# A real refactor that removes half a file essentially always adds something (an import, a call,
# a shorter replacement). Deletions (git rm) are exempt — --diff-filter=M only sees modifications.
trunc=""
for f in $(git diff --cached --name-only --diff-filter=M); do
  old=$(git cat-file -s "$(git rev-parse HEAD:"$f" 2>/dev/null)" 2>/dev/null) || continue
  new=$(git cat-file -s "$(git rev-parse ":$f" 2>/dev/null)" 2>/dev/null) || continue
  [ -z "$old" ] || [ -z "$new" ] && continue
  # shrank to under half?
  [ "$((new * 2))" -lt "$old" ] || continue
  # ...and the diff adds NOTHING at all?
  if [ "$(git diff --cached --numstat -- "$f" | awk '{print $1}')" = "0" ]; then
    trunc="$trunc  $f  ($old -> $new bytes, no lines added)
"
  fi
done
if [ -n "$trunc" ]; then
  echo "pre-commit ABORTED: file(s) look TRUNCATED, not edited —" >&2
  printf '%s' "$trunc" >&2
  echo "" >&2
  echo "Each shrank by more than half with ZERO lines added. That is the Nextcloud partial-write" >&2
  echo "signature this repo has hit twice, not a refactor. Most of these files are in" >&2
  echo "EXTRA_UPDATE_FILES, so committing one deploys it to the whole fleet." >&2
  echo "" >&2
  echo "Check first:  wc -l <file>  vs  git show HEAD:<file> | wc -l" >&2
  echo "Restore with: git restore --source=HEAD -- <file>" >&2
  echo "If the deletion really is intentional: git commit --no-verify" >&2
  exit 1
fi

hit=0
# Added lines only, staged content only. --diff-filter=d skips deletions (removing a secret is
# exactly what we want to encourage, and must never itself be blocked).
if git diff --cached --no-color --diff-filter=d -U0 | grep -Eq "^\+.*($SECRET_PAT)"; then
  hit=1
fi

if [ "$hit" -eq 1 ]; then
  echo "pre-commit ABORTED: a secret pattern (forge token / cleartext sshpass password) is in the" >&2
  echo "STAGED changes. Blocking here rather than at push, so it never enters history at all." >&2
  echo "" >&2
  echo "Offending file(s):" >&2
  git diff --cached --no-color --diff-filter=d --name-only | while read -r f; do
    if git diff --cached --no-color --diff-filter=d -U0 -- "$f" | grep -Eq "^\+.*($SECRET_PAT)"; then
      echo "  $f" >&2
    fi
  done
  echo "" >&2
  echo "Unstage it (git restore --staged <file>) and remove the literal, or --no-verify if it is" >&2
  echo "a false positive. Session notes belong OUTSIDE the repo — see ../im-session-notes/." >&2
  exit 1
fi
exit 0
